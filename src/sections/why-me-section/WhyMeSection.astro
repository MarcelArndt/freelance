---
import ParagrafComponent from "../../components/ParagrafComponent.astro";
import LoadingBarComponent from "../../components/LoadingBarComponent.astro";
import ScoreRingComponent from "../../components/ScoreRingComponent.astro";
import content from "./text.json";
import RampCurtainComponent from "../../components/RampCurtainComponent.astro";

export interface Props {
	title?: string;
	subtitle?: string;
	text?: string;
}

const {
	title = content.title,
	subtitle = content.subtitle,
	text = content.text,
}: Props = Astro.props;

const { speedCard, lighthouseCard } = content;

const formatSeconds = (seconds: number) =>
	`${seconds.toLocaleString("de-DE", { minimumFractionDigits: 1 })} s`;
---

<section class="why" id="whyMe">
	<RampCurtainComponent color="var(--bg-grey)"></RampCurtainComponent>
	<div class="inner-content-wrapper">
	<div class="why__content">
		<p class="why__subtitle">{subtitle}</p>
		<h1 class="why__title">{title}</h1>

		<ParagrafComponent size="md" color="#5f5f5f" maxWidth="55ch" class="why__text">
			{text}
		</ParagrafComponent>

		<div class="why__cards">
			<article class="card card--light">
				<h3 class="card__title">{speedCard.title}</h3>

				<div class="bars">
					{
						speedCard.bars.map((bar, index) => (
							<div class:list={["bar-row", bar.highlight && "bar-row--highlight"]}>
								<div class="bar-row__head">
									<span class="bar-row__label">{bar.label}</span>
									<span class="bar-row__value">{formatSeconds(bar.seconds)}</span>
								</div>
								<LoadingBarComponent
									currentValue={bar.seconds}
									maxValue={speedCard.maxSeconds}
									barColor={bar.highlight ? "var(--accent)" : "#9b9b9b"}
									backgroundColor="#d6d6d6"
									borderRadius="0px"
									height="10px"
									margin="0px"
									showLabel={false}
									delay={index * 150}
								/>
							</div>
						))
					}
				</div>

				<p class="card__footnote">{speedCard.footnote}</p>
			</article>

			<article class="card card--dark">
				<h3 class="card__title">{lighthouseCard.title}</h3>

				<div class="rings">
					{
						lighthouseCard.scores.map((score, index) => (
							<ScoreRingComponent
								value={score.value}
								label={score.label}
								ringColor="var(--lighthouse-green)"
								trackColor="rgba(255, 255, 255, 0.1)"
								valueColor="#ffffff"
								labelColor="rgba(255, 255, 255, 0.7)"
								delay={index * 150}
							/>
						))
					}
				</div>

				<p class="card__footnote">{lighthouseCard.footnote}</p>
			</article>
		</div>
	</div>
	</div>
</section>

<style>
	.why {
		--card-light-bg: #ededed;
		--card-dark-bg: #141414;
		width: 100%;
		background-color: #ffffff;
		display: flex;
		justify-content: center;
		position: relative;
		box-sizing: border-box;
		padding-bottom: 60px;
	}

	.why__content {
		width: 100%;
		max-width: var(--max-page-width);
		padding: clamp(3rem, 10vw, 6rem) 0px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.why__subtitle {
		margin: 0;
		font-family: var(--headline);
		font-size: 1.25rem;
		font-weight: 300;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent);
	}

	.why__title {
		margin: 0 0 0.5rem;
		font-family: var(--headline);
		font-size: var(--h2);
		line-height: 1.1;
		color: #2b0713;
		max-width: 18ch;
	}

	.why__cards {
		width: 100%;
		margin-top: clamp(2rem, 4vw, 3rem);
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 3rem);
	}

	.card {
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		padding: clamp(1.5rem, 2.5vw, 2.5rem);
	}

	.card--light {
		background-color: var(--card-light-bg);
	}

	.card--dark {
		background-color: var(--card-dark-bg);
	}

	.card__title {
		margin: 0 0 clamp(1.5rem, 2.5vw, 2.25rem);
		font-family: var(--font);
		font-size: 1.15rem;
		font-weight: 600;
		color: #161616;
	}

	.card--dark .card__title {
		color: #ffffff;
	}

	.card__footnote {
		margin: auto 0 0;
		padding-top: clamp(1.25rem, 2.5vw, 2rem);
		font-family: var(--font);
		font-size: var(--p-xs);
		font-weight: 300;
		color: #6a6a6a;
	}

	.card--dark .card__footnote {
		color: rgba(255, 255, 255, 0.65);
	}

	.bars {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.bar-row__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
		font-family: var(--font);
		font-size: var(--p-sm);
		font-weight: 300;
		color: #4e4e4e;
	}

	.bar-row--highlight .bar-row__head {
		color: var(--accent);
		font-weight: 600;
	}

	.rings {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem);
		justify-items: center;
	}

	@media (max-width: 900px) {
		.why__cards {
			grid-template-columns: minmax(0, 1fr);
		}

		.why__title {
			max-width: none;
		}
	}
</style>