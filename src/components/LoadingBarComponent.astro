---
export interface Props {
	id?: string;
	width?: string;
	height?: string;
	barColor?: string;
	backgroundColor?: string;
	maxWidth?: string;
	borderRadius?: string;
	currentValue?: number;
	maxValue?: number;
	showLabel?: boolean;
    fontFamily?:string,
    fontColor?:string,
    fontSize?:string,
    fontWeight?:string
    margin?:string
	/** Balken füllt sich erst, wenn er in den Viewport scrollt. */
	animateOnView?: boolean;
	/** Dauer der Füllanimation in ms. */
	duration?: number;
	/** Verzögerung in ms – für gestaffelte Balken. */
	delay?: number;
	easing?: string;
	/** true = Animation läuft bei jedem erneuten Scrollen neu. */
	repeat?: boolean;
}

const {
	id,
	width = "100%",
	height = "2rem",
	barColor = "var(--accent)",
	backgroundColor = "grey",
	maxWidth = "100%",
	borderRadius = "24px",
	currentValue = 0,
	maxValue = 100,
	showLabel = true,
    fontFamily = "var(--font)",
    fontColor = "var(--ink-6)",
    fontSize = "0.85em",
    fontWeight = "300",
    margin = "0.5rem 0px 0.5rem 0px",
	animateOnView = true,
	duration = 1200,
	delay = 0,
	easing = "cubic-bezier(0.22, 1, 0.36, 1)",
	repeat = false,
}: Props = Astro.props;

const percent = Math.min(100, Math.max(0, (currentValue / maxValue) * 100));

const varStyle = [
	`--width:${width}`,
	`--height:${height}`,
	`--bar-color:${barColor}`,
	`--background-color:${backgroundColor}`,
	`--max-width:${maxWidth}`,
	`--border-radius:${borderRadius}`,
	`--percent:${percent}%`,
    `--fontFamily:${fontFamily}`,
    `--fontSize:${fontSize}`,
    `--fontColor:${fontColor}`,
    `--fontWeight:${fontWeight}`,
    `--margin:${margin}`,
	`--duration:${duration}ms`,
	`--delay:${delay}ms`,
	`--easing:${easing}`,
].join(";");
---

<div
	id={id}
	class="bar-wrapper"
	style={varStyle}
	loading-bar={animateOnView ? "" : null}
	data-repeat={animateOnView && repeat ? "" : null}
>
	<div class="bar-background">
		<div class="bar-fill"></div>
	</div>
    {showLabel && <p class="bar-label">{Math.round(percent)}%</p>}
</div>

<script>
	import { observeInView, nextFrame } from "../utils/scripts/inView";

	const bars = document.querySelectorAll<HTMLElement>("[loading-bar]");

	observeInView(
		bars,
		(bar) => nextFrame(() => bar.classList.add("is-filled")),
		(bar) => bar.classList.remove("is-filled"),
		{ threshold: 0.4, repeat: Array.from(bars).some((bar) => bar.hasAttribute("data-repeat")) },
	);
</script>

<style>
	.bar-wrapper {
		position: relative;
		width: var(--width);
		max-width: var(--max-width);
        margin:var(--margin)
	}

	.bar-background {
		width: 100%;
		height: var(--height);
		background-color: var(--background-color);
		border-radius: var(--border-radius);
		overflow: hidden;
        position: static;
        z-index: 1;
	}

	.bar-fill {
		height: 100%;
		/* Ohne Scroll-Animation (z.B. animateOnView={false}) direkt gefüllt. */
		width: var(--percent);
		background-color: var(--bar-color);
		border-radius: inherit;
		transition: width var(--duration) var(--easing) var(--delay);
        position: static;
        z-index: 1
	}

	/* Startzustand: leer, bis der Balken in den Viewport scrollt. */
	[loading-bar] .bar-fill {
		width: 0%;
	}

	[loading-bar].is-filled .bar-fill {
		width: var(--percent);
	}

	/* Kein JavaScript: Balken bleibt sichtbar gefüllt statt leer. */
	@media (scripting: none) {
		[loading-bar] .bar-fill {
			width: var(--percent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bar-fill {
			transition-duration: 1ms;
			transition-delay: 0ms;
		}
	}

	.bar-label {
		position: absolute;
        z-index: 99;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: var(--fontSize);
        font-weight: var(--fontWeight);
		pointer-events: none;
        font-family: var(--fontFamily);
        left: 50%;
        top: 50%;
        transform: translate(-50%,-50%);
        color: var(--fontColor);
        mix-blend-mode: difference
	}

</style>