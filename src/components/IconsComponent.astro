---
import fs from "node:fs";
import path from "node:path";

export interface Props {
	src: string;
	size?: string | number;
	class?: string;
	title?: string;
}

const { src, size, class: className, title}: Props = Astro.props;

const filePath = path.join(process.cwd(), "public", src.replace(/^\//, ""));
let svg = fs.readFileSync(filePath, "utf-8");

svg = svg.replace(/\s(width|height)="[^"]*"/g, "");
svg = svg.replace(
	"<svg",
	title ? `<svg role="img" aria-label="${title}"` : `<svg aria-hidden="true" focusable="false"`,
);

const style = size ? `--icon-size: ${typeof size === "number" ? `${size}px` : size};` : undefined;
---

<span class:list={["icon", className]} style={style} set:html={svg} />

<style>
	.icon {
		display: inline-flex;
		flex-shrink: 0;
		width: var(--icon-size, 1em);
		height: var(--icon-size, 1em);
	}

	.icon :global(svg) {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}
</style>