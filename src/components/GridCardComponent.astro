---
export interface Props {
	/** Spalten auf großen Screens. */
	columns?: number;
	/** Spalten ab 1024px abwärts. */
	columnsTablet?: number;
	/** Spalten ab 640px abwärts. */
	columnsMobile?: number;
	gap?: string;
	/** "stretch" = alle Karten einer Zeile sind gleich hoch. */
	align?: "stretch" | "start";
	class?: string;
}

const {
	columns = 4,
	columnsTablet = 2,
	columnsMobile = 1,
	gap = "clamp(1rem, 2vw, 1.5rem)",
	align = "stretch",
	class: className,
}: Props = Astro.props;

// minmax(0, 1fr) statt 1fr: sonst wächst eine Spalte über ihren Anteil
// hinaus, sobald der Inhalt (z.B. ein langes Wort) breiter ist.
const varStyle = [
	`--grid-columns:${columns}`,
	`--grid-columns-tablet:${columnsTablet}`,
	`--grid-columns-mobile:${columnsMobile}`,
	`--grid-gap:${gap}`,
	`--grid-align:${align}`,
].join(";");
---

<div class:list={["card-grid", className]} style={varStyle}>
	<slot />
</div>

<style>
	.card-grid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
		gap: var(--grid-gap);
		align-items: var(--grid-align);
	}

	@media (max-width: 1024px) {
		.card-grid {
			grid-template-columns: repeat(var(--grid-columns-tablet), minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.card-grid {
			grid-template-columns: repeat(var(--grid-columns-mobile), minmax(0, 1fr));
		}
	}
</style>