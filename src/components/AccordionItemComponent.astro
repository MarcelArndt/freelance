---
import ParagrafComponent from "./ParagrafComponent.astro";

/**
 * Eine Zeile im Accordion: Frage als Button, Antwort im ausfahrenden Panel.
 *
 * Das Panel ist ein Grid mit einer Zeile, animiert wird `grid-template-rows`
 * von `0fr` auf `1fr`. Über `height: auto` ließe sich nicht animieren, ohne
 * die Höhe vorher per JavaScript auszumessen.
 *
 * Der geschlossene Zustand hängt an `html.js` – ohne JavaScript stehen alle
 * Antworten offen da, statt unerreichbar zu sein.
 */
export interface Props {
	question: string;
	answer?: string;
	/** Beim Laden schon offen. */
	open?: boolean;
	id?: string;
	class?: string;
}

const { question, answer, open = false, id, class: className }: Props = Astro.props;

// Ohne feste id reicht eine aus der Frage abgeleitete – sie verbindet nur
// Button und Panel miteinander. Umlaute werden umgeschrieben, damit in den
// Attributen reines ASCII steht.
const slug =
	id ??
	question
		.toLowerCase()
		.replace(/ä/g, "ae")
		.replace(/ö/g, "oe")
		.replace(/ü/g, "ue")
		.replace(/ß/g, "ss")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-|-$/g, "")
		.slice(0, 40);

const panelId = `faq-panel-${slug}`;
const triggerId = `faq-trigger-${slug}`;
---

<div class:list={["accordion__item", className]} data-accordion-item data-open={open ? "" : undefined}>
	{/* Die Überschrift trägt den Button, nicht umgekehrt – so bleibt die
	    Gliederung für Screenreader erhalten. */}
	<h3 class="accordion__heading">
		<button
			class="accordion__trigger"
			type="button"
			id={triggerId}
			aria-controls={panelId}
			aria-expanded={open ? "true" : "false"}
			data-accordion-trigger
		>
			<span class="accordion__question">{question}</span>
			<span class="accordion__icon" aria-hidden="true"></span>
		</button>
	</h3>

	<div class="accordion__panel" id={panelId} role="region" aria-labelledby={triggerId}>
		<div class="accordion__inner">
			<ParagrafComponent size="sm" color="#5f5f5f" maxWidth="62ch" class="accordion__answer">
				<slot>{answer}</slot>
			</ParagrafComponent>
		</div>
	</div>
</div>

<style>
	.accordion__item {
		border-top: var(--line-thickness) solid var(--accordion-line, #e2e2e2);
	}

	.accordion__item:first-child {
		border-top: 0;
	}

	.accordion__heading {
		margin: 0;
		font-size: inherit;
		font-weight: inherit;
	}

	/* Buttons sind global gestylt (grüne Fläche, Radius, Padding) – hier wird
	   die ganze Zeile zur Schaltfläche, deshalb alles zurücksetzen. */
	button.accordion__trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		width: 100%;
		box-sizing: border-box;
		padding: clamp(1rem, 2vw, 1.4rem) clamp(1rem, 2.5vw, 2rem);
		background-color: transparent;
		border: 0;
		border-radius: 0;
		text-align: left;
		font-family: var(--font);
		font-size: var(--p-sm);
		font-weight: 600;
		line-height: 1.4;
		color: var(--ink-6);
		cursor: pointer;
		transition: color 0.25s ease-in-out, background-color 0.25s ease-in-out;
	}

	/* Kein Anheben wie bei den echten Buttons – die Zeile sitzt in einer Liste
	   und würde sonst gegen ihre Nachbarn springen. */
	button.accordion__trigger:hover {
		transform: none;
		background-color: transparent;
		color: var(--accent);
	}

	button.accordion__trigger:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	/* Plus aus zwei Strichen: der senkrechte dreht sich beim Öffnen auf die
	   Waagerechte und liegt dann deckungsgleich – aus + wird −. */
	.accordion__icon {
		position: relative;
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
	}

	.accordion__icon::before,
	.accordion__icon::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 2px;
		background-color: var(--ink-3);
		translate: 0 -50%;
		transition: background-color 0.25s ease-in-out;
	}

	/* Die Drehung bleibt bei 0.35s wie das Ausfahren, die Farbe wechselt in
	   0.25s wie überall sonst – deshalb zwei Angaben in einer transition. */
	.accordion__icon::after {
		rotate: 90deg;
		transition: rotate 0.35s ease-in-out, background-color 0.25s ease-in-out;
	}

	/* Beide Striche nehmen die Akzentfarbe an, sobald die Zeile unter dem
	   Zeiger liegt – Tastaturfokus zählt genauso. */
	button.accordion__trigger:hover .accordion__icon::before,
	button.accordion__trigger:hover .accordion__icon::after,
	button.accordion__trigger:focus-visible .accordion__icon::before,
	button.accordion__trigger:focus-visible .accordion__icon::after {
		background-color: var(--accent);
	}

	.accordion__item[data-open] .accordion__icon::after {
		rotate: 0deg;
	}

	/* Der eigentliche Trick: eine Grid-Zeile von 0fr auf 1fr. Das Kind muss
	`overflow: hidden` und `min-height: 0` haben, sonst kann die Zeile nicht
	unter die Inhaltshöhe schrumpfen. */
	.accordion__panel {
		display: grid;
		grid-template-rows: 1fr;
		transition: grid-template-rows 0.35s ease-in-out;
	}

	.accordion__inner {
		overflow: hidden;
		min-height: 0;
	}

	.accordion__panel :global(.accordion__answer) {
		padding: 0 clamp(1rem, 2.5vw, 2rem) clamp(1rem, 2vw, 1.4rem);
	}

	/* Geschlossen wird erst mit JavaScript – ohne bleibt oben `1fr` stehen. */
	:global(html.js) .accordion__panel {
		grid-template-rows: 0fr;
	}

	:global(html.js) .accordion__item[data-open] .accordion__panel {
		grid-template-rows: 1fr;
	}

	/* Zusammengeklappt ist der Text nur 0px hoch, aber weiterhin vorlesbar.
	   visibility nimmt ihn aus dem Baum – verzögert, damit das Zuklappen
	   vorher noch sichtbar ist. */
	:global(html.js) .accordion__inner {
		visibility: hidden;
		transition: visibility 0s linear 0.35s;
	}

	:global(html.js) .accordion__item[data-open] .accordion__inner {
		visibility: visible;
		transition-delay: 0s;
	}

	@media (prefers-reduced-motion: reduce) {
		button.accordion__trigger,
		.accordion__icon::before,
		.accordion__icon::after,
		.accordion__panel,
		:global(html.js) .accordion__inner {
			transition-duration: 1ms;
			transition-delay: 0s;
		}
	}
</style>
