---
import { anchors, pages } from "../lib/site";

export interface Props {
	items?: { label: string; href: string }[];
}

// Ziele kommen aus src/lib/site.ts – dort steht auch, was noch auf "#" wartet.
const {
	items = [
		{ label: "Warum Ich", href: pages.whyMe },
		{ label: "Leistungen", href: pages.leistungen },
		{ label: "Preise", href: anchors.preise },
		{ label: "FAQ", href: anchors.faq },
		{ label: "Projekt anfragen", href: anchors.kontakt },
	],
}: Props = Astro.props;
---

<nav class="navigation" aria-label="Hauptnavigation">
	<button
		class="burger"
		type="button"
		aria-expanded="false"
		aria-controls="primary-menu"
		aria-label="Menü öffnen">
		<span class="burger-line"></span>
		<span class="burger-line"></span>
		<span class="burger-line"></span>
	</button>

	<ul class="menu" id="primary-menu">
		{items.map((item) => (
			<li>
				<a href={item.href}>{item.label}</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.navigation {
		position: relative;
		display: flex;
		align-items: center;
	}

	.menu {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2vw, 2.25rem);
		list-style: none;
		margin: 0;
		padding: 0;
		height: 100%;
	}

	.menu a {
		font-family: var(--font);
		font-size: var(--p-sm);
		color: var(--ink-2);
		text-decoration: none;
		white-space: nowrap;
		font-weight: 300;
	}

	.menu a:hover,
	.menu a:focus-visible {
		color: var(--link-hover);
	}

	.burger {
		display: none;
		flex-direction: column;
		justify-content: space-between;
		width: 32px;
		height: 22px;
		padding: 0;
		background: none;
		border: none;
		cursor: pointer;
		z-index: 20;
	}

	.burger-line {
		display: block;
		width: 100%;
		height: var(--line-thicker);
		background-color: var(--ink-1);
		border-radius: 2px;
		transform-origin: center;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.navigation.is-open .burger-line:nth-child(1) {
		transform: translateY(9px) rotate(45deg);
	}

	.navigation.is-open .burger-line:nth-child(2) {
		opacity: 0;
	}

	.navigation.is-open .burger-line:nth-child(3) {
		transform: translateY(-9px) rotate(-45deg);
	}

	/* below this width the inline menu becomes a slide-in burger panel */
	@media (max-width: 768px) {
		.burger {
			display: flex;
		}

		.menu {
			position: fixed;
			inset: var(--header-height) 0 0 0;
			/* Die Höhe kommt aus inset. Ohne das Zurücksetzen würde das
			   height:100% der Basis-Regel den unteren Rand überschreiben und
			   die Fläche um die Header-Höhe unten hinausschieben. */
			height: auto;
			box-sizing: border-box;
			flex-direction: column;
			justify-content: flex-start;
			gap: 1.5rem;
			padding: 2.5rem var(--inner-padding);
			background-color: var(--bg-header);
			backdrop-filter: blur(0.75rem);
			overflow-y: auto;
			transform: translateX(100%);
			transition: transform 0.3s ease;
		}

		.navigation.is-open .menu {
			transform: translateX(0);
		}

		.menu a {
			font-size: var(--p-lg);
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>(".navigation").forEach((nav) => {
		const burger = nav.querySelector<HTMLButtonElement>(".burger");
		const menu = nav.querySelector<HTMLElement>(".menu");
		if (!burger || !menu) return;

		const close = () => {
			nav.classList.remove("is-open");
			burger.setAttribute("aria-expanded", "false");
			burger.setAttribute("aria-label", "Menü öffnen");
		};

		const toggle = () => {
			const isOpen = nav.classList.toggle("is-open");
			burger.setAttribute("aria-expanded", String(isOpen));
			burger.setAttribute("aria-label", isOpen ? "Menü schließen" : "Menü öffnen");
		};

		burger.addEventListener("click", toggle);
		menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") close();
		});
	});
</script>